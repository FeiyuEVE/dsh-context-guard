{
  "name": "dsh-context-guard",
  "version": "0.1.0",
  "description": "DeepSeek Harness 上下文压力守卫插件：步骤结束时超阈值注入收尾提醒、agent 空闲时自动压缩超阈值会话、压缩完成后自动续跑任务（三者均可用配置开关）。Context-pressure guard plugin for DeepSeek Harness: wraps up over-threshold turns with an injected reminder, auto-compacts over-threshold idle sessions, and resumes the task after a completed compaction.",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-token-meter": "0.1.1-rc.2 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2 || 0.1.2-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^24.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "esbuild": "^0.28.1",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeiyuEVE/dsh-context-guard.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context",
    "compaction",
    "token",
    "guard"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && npm run build:client",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build",
    "build:client": "node scripts/build.mjs"
  }
}
